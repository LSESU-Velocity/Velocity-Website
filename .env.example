# Firebase Admin SDK (from service account JSON)
# Used for non-Launchpad features only.
FIREBASE_PROJECT_ID=your-project-id-here
FIREBASE_CLIENT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Exact browser origins allowed to call API routes cross-origin.
# Preview deployments must be listed explicitly; wildcard preview origins are not trusted.
# Defaults to https://lsesuvelocity.com and https://www.lsesuvelocity.com when omitted.
ALLOWED_ORIGINS=

# Launchpad Lab — BYOK (Bring Your Own Key)
#
# Launchpad Lab does NOT use a platform Gemini API key.
# Users supply their own Google AI Studio key in the browser,
# which is sent via the x-gemini-key header per request.
# The variables below only control which model the backend uses.

# Gemini model override (default: gemini-3.1-flash-lite-preview)
LAUNCHPAD_GEMINI_MODEL=

# Optional dedicated research model override for the grounded web-search node.
# Defaults to gemini-2.5-flash-lite so free-tier Search grounding works.
LAUNCHPAD_RESEARCH_MODEL=

# Optional fallback if the primary free-tier model is unavailable.
LAUNCHPAD_GEMINI_FALLBACK_MODEL=

# --- Automation Intake ---
#
# Server-side kill switch for AI-assisted chat. If not exactly "true", the
# chat route never calls the model — every turn degrades to the deterministic
# step flow. The browser is unaware of this switch; the chat UI is identical
# in both modes.
AUTOMATION_INTAKE_ASSISTED_CHAT_ENABLED=

# Gemini key + model used for per-step extraction and follow-up drafting when
# assisted chat is enabled. Leaving the key blank also forces deterministic mode.
AUTOMATION_INTAKE_GEMINI_API_KEY=
AUTOMATION_INTAKE_GEMINI_MODEL=gemini-2.5-flash-lite
# Optional — keep at 0 or 1. Retries increase tail latency and spend risk.
AUTOMATION_INTAKE_MODEL_MAX_RETRIES=0

# Global daily AI spend ceiling for intake, in US cents. Default: 500 ($5/day).
# Once crossed, all further turns degrade to deterministic until UTC midnight.
AUTOMATION_INTAKE_AI_DAILY_CAP_USD_CENTS=500

# 64 hex characters / 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for /api/automation-intake-submit to persist any record.
AUTOMATION_INTAKE_ENCRYPTION_KEY=
