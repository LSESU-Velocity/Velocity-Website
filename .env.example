# Firebase Admin SDK (from service account JSON)
# Used for non-Launchpad features only.
FIREBASE_PROJECT_ID=your-project-id-here
FIREBASE_CLIENT_EMAIL=your-service-account-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Launchpad Lab — BYOK (Bring Your Own Key)
#
# Launchpad Lab does NOT use a platform Gemini API key.
# Users supply their own Google AI Studio key in the browser,
# which is sent via the x-gemini-key header per request.
# The variables below only control which model the backend uses.

# Gemini model override (default: gemini-3.1-flash-lite-preview)
LAUNCHPAD_GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Optional fallback if the primary free-tier model is unavailable.
LAUNCHPAD_GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
